{
  "expo": {
    "name": "Kinto",
    "slug": "klinto",
    "version": "1.10.105",
    "orientation": "portrait",
    "scheme": "klinto",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "jsEngine": "hermes",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      ["expo-router", { "origin": "https://kintoapp.xyz" }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0E14",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0A0E14",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "googleServicesFile": "./google-services.json"
          },
          "ios": {
            "googleServicesFile": "./GoogleService-Info.plist",
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "react-native-background-fetch",
      "./plugins/withNotifeeForegroundService",
      "@livekit/react-native-expo-plugin",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Kinto подключается к модулям связи по Bluetooth для работы mesh-сети."
        }
      ],
      "expo-sqlite",
      "expo-build-properties",
      [
        "expo-av",
        {
          "microphonePermission": "Kinto использует микрофон для записи голосовых сообщений."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kinto открывает галерею, чтобы отправлять фото и видео и ставить фон чатов и профиля."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pink-project.kintoapp",
      "buildNumber": "11105",
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Kinto подключается к модулям связи по Bluetooth для работы mesh-сети.",
        "NSBluetoothPeripheralUsageDescription": "Kinto использует Bluetooth для связи с носимыми модулями.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification",
          "bluetooth-central",
          "audio",
          "voip"
        ],
        "FirebaseAppDelegateProxyEnabled": true,
        "NSMicrophoneUsageDescription": "Kinto использует микрофон для записи голосовых сообщений.",
        "NSPhotoLibraryUsageDescription": "Kinto открывает галерею, чтобы отправлять фото и видео и ставить фон чатов и профиля."
      }
    },
    "android": {
      "package": "com.pink_project.kintoapp",
      "versionCode": 11105,
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F88011"
      },
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "extra": {
      "apiUrl": "https://hub.kintoapp.xyz/api"
    }
  }
}